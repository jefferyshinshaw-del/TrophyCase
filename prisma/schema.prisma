// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String?
  cards UserCard[]
}

model Card {
  id          Int         @id @default(autoincrement())
  name        String
  set         String?
  year        Int?
  player      String?
  grade       String?
  imageUrl    String?
  pricePoints PricePoint[]
  listings    Listing[]
  userCards   UserCard[]
}

model UserCard {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  card        Card     @relation(fields: [cardId], references: [id])
  cardId      Int
  quantity    Int      @default(1)
  purchasePrice Float?
  purchaseDate  DateTime?
  notes       String?
}

model PricePoint {
  id      Int      @id @default(autoincrement())
  card    Card     @relation(fields: [cardId], references: [id])
  cardId  Int
  timestamp DateTime @default(now())
  price   Float
  source  String?
}

model Listing {
  id        Int      @id @default(autoincrement())
  card      Card     @relation(fields: [cardId], references: [id])
  cardId    Int
  marketplace String
  price     Float
  currency  String  @default("USD")
  url       String?
  listedAt  DateTime @default(now())
}

model MarketMover {
  id        Int   @id @default(autoincrement())
  card      Card  @relation(fields: [cardId], references: [id])
  cardId    Int
  changePct Float
  volume    Int
  timeframe String
}
